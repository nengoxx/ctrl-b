# ctrl-b environment — copy to `.env` (gitignored). Everything here is OPTIONAL.
#
# WHERE THIS FILE LIVES: always the code checkout, `<checkout>/.env` (e.g. ~/apps/ctrl-b/.env on a
# server install) — never under $CTRLB_HOME. Its values fill the environment at startup, and a variable
# already set in the REAL environment always wins over this file. A change here needs a restart.
#
# Secrets model is HYBRID (docs/DESIGN.md §9):
#   • config.yaml  = the UI-managed source of truth, and the ONLY home for secrets
#                    (per-host SSH creds, per-provider API keys). Gitignored; the app's own
#                    saves leave it at 0600. The Conf tab edits it.
#   • .env (this)  = bootstrap paths + overrides for DECLARED, ONE-LEVEL SCALARS.
#                    It cannot reach a provider credential — those live at
#                    providers.<name>.api_key, two levels down — and structured config
#                    (host lists, MCP servers) is not settable here either.
#
# Every key, its default and when it applies: docs/user-guide/configuration-reference.md.

# --- bootstrap paths (where the app reads config / writes the db) ---
# CTRLB_HOME=~/.ctrl-b          # the data root: config.yaml, ctrlb.db, agents/, skills/, memories/,
#                               # media/, attachments/, lorebooks/, calls/, backups/. Default: the checkout.
# CTRLB_CONFIG=/path/config.yaml  # default: $CTRLB_HOME/config.yaml
# CTRLB_DB=/path/ctrlb.db         # default: $CTRLB_HOME/ctrlb.db
# CTRLB_ENV locates THIS file, so it only works when set in the REAL environment (not in here).

# --- config overrides: CTRLB_<SECTION>__<KEY> overrides config.yaml's <section>.<key> ---
# Note the DOUBLE underscore between section and key. One level, scalars only; names are
# case-insensitive and values are strings the schema converts. What happens on a mistake:
#   • an unknown key inside a section (CTRLB_SERVER__NOPE) is LOGGED as ineffective and ignored;
#   • an override aimed at a map/list section (CTRLB_PROVIDERS__…, CTRLB_COMPUTERS__…,
#     CTRLB_MCP_SERVERS__…), at a list/nested field (CTRLB_SERVER__TRUSTED_HOSTS,
#     CTRLB_AGENT__COMPACTION), or carrying a bad value (CTRLB_SERVER__PORT=abc) fails validation
#     and the server REFUSES TO START (exit 78, the message names the path);
#   • a variable naming a path a config migration retired makes
#     `python -m app.config_migration --check` / `--apply` refuse.
# Conf shows an overridden value with no marker; a Conf edit of it applies until the next restart
# (or the next host / persona / integration save), when this value wins again.
# CTRLB_SERVER__POLL_SECONDS=5
# CTRLB_SERVER__DEBUG=false          # true = DEBUG app logging (no debugger); needs a restart
# CTRLB_TAILSCALE__TARGET_PORT=5433  # the local port Tailscale Serve fronts
# CTRLB_SERVER__HOST / CTRLB_SERVER__PORT are INERT (ISS-91): they bind nothing — the listening
# socket comes from the uvicorn command line (systemd unit / run.sh / start.ps1); PORT only changes
# what /api/health reports, and HOST only feeds Conf's "restart to apply" flag.

# --- NOT settable here: provider and host credentials ---
# There is deliberately no way to supply a provider API key or a host's SSH password from this file
# (they live in nested maps/lists this one-level grammar cannot reach). The one exception is the
# one-level scalar open_terminal.api_key (CTRLB_OPEN_TERMINAL__API_KEY). Earlier revisions of this
# example advertised CTRLB_INFERENCE__CLOUD_KEY / CTRLB_STT__KEY / CTRLB_TTS__KEY /
# CTRLB_EMBEDDINGS__KEY — none of those ever named a real field, so they silently did nothing.
# Put the key in config.yaml (Conf tab → Providers), which is gitignored.
