# Deploy scripts run on Linux (emma) — force LF so a CRLF working tree can never break them
# (a CRLF shebang fails with `bad interpreter: /usr/bin/env bash^M`). Scoped to the deploy kit
# to avoid renormalizing the rest of the repo.
deploy/linux/** text eol=lf
tools/*.sh     text eol=lf
# Git hooks run via sh on emma — force LF so a CRLF checkout can't break the shebang (1d).
.githooks/**   text eol=lf
