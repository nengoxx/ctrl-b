# ── secrets / runtime config (never commit — see CLAUDE.md hard rules) ──
config.yaml
config.yaml.*
.env
.env.*
clients
*_prompt.*

# ── agent memory / personal data (D14: per-agent MEMORY.md + global USER.md) ──
memories/
agents/*/memories/
# the call trails + debug audio captures, and the ASR corpus (Phase 26 S6-ii, SECURITY_MODEL §2.12): with
# CTRLB_HOME unset, `home_path()` falls back to this project root — the owner's audio must never be tracked
/calls/
/asr-corpus/

# ── databases ──
*.db
*.db-wal
*.db-shm

# ── python ──
__pycache__/
*.py[cod]
.venv/
.venv*/
*.egg-info/
.pytest_cache/

# ── node / frontend build output (regenerable — npm install / vite build recreate) ──
node_modules/
dist/
build/
.vite/
*.local
*.tsbuildinfo

# ── logs ──
*.log

# ── editor / OS ──
.DS_Store

# ── local design/reference images (kept on-disk as references only; never versioned) ──
docs/screenshot/

# ── local demo videos (never committed — the README embeds a GitHub user-attachment) ──
assets/*.mp4

