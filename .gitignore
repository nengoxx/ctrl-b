# ── secrets / runtime config (never commit — see CLAUDE.md hard rules) ──
config.yaml
.env
.env.*
clients
*_prompt.*

# ── agent memory / personal data (D14: per-agent MEMORY.md + global USER.md) ──
memories/
agents/*/memories/

# ── databases ──
*.db
*.db-wal
*.db-shm

# ── python ──
__pycache__/
*.py[cod]
.venv/
.venv*/
*.egg-info/
.pytest_cache/

# ── node / frontend build output (regenerable — npm install / vite build recreate) ──
node_modules/
dist/
build/
.vite/
*.local
*.tsbuildinfo

# ── logs ──
*.log

# ── editor / OS ──
.DS_Store

# ── local design/reference images (kept on-disk as references only; never versioned) ──
docs/screenshot/

# ── legacy demo video (142 MB; never committed — demo.gif is the tracked one) ──
assets/demo.mp4
