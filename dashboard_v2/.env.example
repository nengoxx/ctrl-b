# dashboard_v2 environment — copy to `.env` (gitignored). Everything here is OPTIONAL.
#
# Secrets model is HYBRID (docs/DESIGN.md §9):
#   • config.yaml  = the UI-managed source of truth, including nested secrets
#                    (per-host SSH creds, per-endpoint API keys). The Conf tab edits it.
#   • .env (this)  = bootstrap/deploy knobs + optional SCALAR secret overrides that WIN
#                    over config.yaml. Structured config (host lists, MCP servers) is NOT
#                    set here — it lives in config.yaml.
#
# Real shell environment variables always take precedence over values in this file.

# --- bootstrap paths (where the app reads config / writes the db) ---
# CTRLB_CONFIG=C:\path\to\config.yaml      # default: dashboard_v2/config.yaml
# CTRLB_DB=C:\path\to\ctrlb.db             # default: dashboard_v2/ctrlb.db
# CTRLB_ENV=C:\path\to\.env                # default: dashboard_v2/.env

# --- config overrides: CTRLB_<SECTION>__<KEY> overrides config.yaml's <section>.<key> ---
# Note the DOUBLE underscore between section and key. Scalars only.
# CTRLB_SERVER__HOST=127.0.0.1
# CTRLB_SERVER__PORT=5433
# CTRLB_SERVER__DEBUG=false
# CTRLB_SERVER__POLL_SECONDS=5

# --- optional secret overrides (keep a key out of config.yaml if you prefer) ---
# These sections arrive in later phases; shown here for reference.
# CTRLB_INFERENCE__CLOUD_KEY=sk-...
# CTRLB_STT__KEY=...
# CTRLB_TTS__KEY=...
# CTRLB_EMBEDDINGS__KEY=...
