# ctrl-b dashboard — PRODUCTION (systemd USER service for emma).
# Install: ~/.config/systemd/user/ctrl-b-dashboard.service  (emma has linger=yes → starts at boot, persists
# without login). uvicorn serves the API + the built frontend/dist on 127.0.0.1:5433; Tailscale Serve fronts
# it with HTTPS (serve-https.sh). Bound to localhost ONLY — never the LAN — so the tailnet (via Serve) is the
# sole ingress. Egress (SSH/ping/WOL to the fleet) is unaffected by the bind.
# Manage:  systemctl --user {start,stop,restart,status} ctrl-b-dashboard
#
# NOTE (deliberate): NO `network-online.target` ordering — that's a SYSTEM target with no user equivalent
# (never reached in a user instance → would block start), and binding localhost needs no network anyway.
# NO `NoNewPrivileges` — it can strip `ping`'s file capabilities (CAP_NET_RAW) → every host reads offline.
[Unit]
Description=ctrl-b dashboard (v2, production)

[Service]
Type=simple
WorkingDirectory=/home/emma/github/ctrl-b/dashboard_v2/backend
Environment=CTRLB_HOME=/home/emma/.ctrl-b
# PROD: serve the built dist, no --reload. Bind localhost; Tailscale Serve is the HTTPS ingress.
ExecStart=/home/emma/github/ctrl-b/dashboard_v2/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 5433
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
