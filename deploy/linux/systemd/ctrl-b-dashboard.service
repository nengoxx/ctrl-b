# ctrl-b dashboard — PRODUCTION (systemd USER service for emma).
# Code tree: ~/apps/ctrl-b — a CLEAN, sparse, tag-pinned clone (only backend/frontend/deploy + root files on disk;
# prototypes never materialize) that pulls from GitHub, so prod runs only pushed, released code (D32, amended
# 2026-07-09: trunk-based — main + immutable tags; the workspace is ~/github/ctrl-b).
# Data root: ~/.ctrl-b. The isolated DEV instance serves the workspace → :5434 → ~/.ctrl-b-dev.
# Install: ~/.config/systemd/user/ctrl-b-dashboard.service  (emma has linger=yes → starts at boot, persists
# without login). uvicorn serves the API + the built frontend/dist on 0.0.0.0:5433 — an OWNER WAIVER
# (2026-07-10, revises the original loopback-only decision; recorded in SECURITY_MODEL.md §2.1): direct
# http://emma:5433 access from the LAN + tailnet, trusted-home-LAN threat model. Tailscale Serve still
# fronts it with HTTPS (serve-https.sh) — required for the mic (secure context). Egress (SSH/ping/WOL to
# the fleet) is unaffected by the bind.
# Manage:  systemctl --user {start,stop,restart,status} ctrl-b-dashboard
#
# TEMPLATE: install.sh renders __REPO__/__CTRLB_HOME__ to this machine's actual paths (any user/host) — do
# NOT copy this file directly. NOTE (deliberate): NO `network-online.target` ordering — that's a SYSTEM target
# with no user equivalent (never reached in a user instance → would block start), and binding localhost needs
# no network anyway. NO `NoNewPrivileges` — it can strip `ping`'s file caps (CAP_NET_RAW) → every host offline.
[Unit]
Description=ctrl-b dashboard (v2, production)

[Service]
Type=simple
WorkingDirectory=__REPO__/backend
Environment=CTRLB_HOME=__CTRLB_HOME__
# PROD: serve the built dist, no --reload. Bind all interfaces (owner waiver above); Serve adds HTTPS.
ExecStart=__REPO__/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 5433
# UPDATE_PLAN slice 4: `app.main` refuses at IMPORT time on a config this build cannot load and
# exits 78 (EX_CONFIG). No restart can fix that, and this unit has no StartLimitBurst — without the
# directive below systemd retries forever at RestartSec=5 (measured: 5 restarts in 8s). With it the
# unit stops in `failed` with one actionable message. Verified to propagate through `--reload` too.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
